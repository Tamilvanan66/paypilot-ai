# ─── Server ───────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=5000
CLIENT_ORIGIN=http://localhost:5173

# ─── Database ─────────────────────────────────────────────────────────────────
# Leave empty in development/test to use an in-memory MongoDB (data is lost on restart).
# In production this is REQUIRED (e.g. MongoDB Atlas connection string).
MONGODB_URI=

# ─── Auth ────────────────────────────────────────────────────────────────────
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=7d
COOKIE_NAME=paypilot_token
RESET_TOKEN_TTL_MINUTES=30

# ─── AI (OpenAI-compatible) ──────────────────────────────────────────────────
# Without a key the app still works using deterministic fallbacks (rules engine + templates).
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini

# ─── PayPal (Sandbox by default) ─────────────────────────────────────────────
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# From the PayPal dashboard webhook you create (needed for signature verification)
PAYPAL_WEBHOOK_ID=
PAYPAL_CURRENCY=USD
# Public HTTPS base URL of THIS API, used to build the webhook URL
PUBLIC_API_URL=http://localhost:5000

# ─── Uploads ─────────────────────────────────────────────────────────────────
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=5
